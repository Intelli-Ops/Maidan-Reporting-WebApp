# Server Config
PORT=5000
# 'production' is the safe default to ship with — it disables the
# forgot-password devOtp echo (see controllers/auth.controller.js) and the
# stack-trace field on error responses. Set to 'development' explicitly for
# local work where you need those.
NODE_ENV=production
JWT_SECRET=<generate-a-long-random-secret-do-not-reuse-this-example>
JWT_EXPIRES_IN=6h
CORS_ORIGIN=*
BCRYPT_SALT_ROUNDS=12

# PostgreSQL / Supabase Database Connection String
# Example: postgresql://postgres:your_password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/maidan_db

# Default Seed Admin Credentials (used only by scripts/seed_admin.js, when
# creating the very first account on an empty database). seed_admin skips
# entirely if the account already exists, so changing these does NOT change an
# existing account's password — use scripts/set_system_admin.js for that.
DEFAULT_ADMIN_EMAIL=admin@maidan.pk
DEFAULT_ADMIN_PASSWORD=<choose-a-strong-password-do-not-reuse-this-example>

# System administrator — used only by scripts/set_system_admin.js, which is
# the one place users.is_system_admin is ever written (see
# sql/schema_update_v16_system_admin.sql). Kept in env rather than passed as
# arguments so no address or password lands in shell history or a process
# list. Run the script once per database; nothing about it is automatic.
SYSTEM_ADMIN_EMAIL=
SYSTEM_ADMIN_PASSWORD=
# Only needed when the address is changing — the address the row has today.
SYSTEM_ADMIN_CURRENT_EMAIL=
SYSTEM_ADMIN_NAME=System Admin

# Registration is restricted to @maidan.pk addresses by default. Set to
# false only while testing before real company mailboxes exist.
REQUIRE_COMPANY_EMAIL=true

# Google Gemini API key (free tier) — powers the /api/ai/ask chatbot endpoint.
# Get one at https://aistudio.google.com/apikey. Leave unset to disable the
# endpoint (it responds 503 instead of crashing the server).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Brevo (free transactional email, 300/day forever, no card) — powers the
# forgot-password OTP email. Sign up at https://www.brevo.com, verify a
# sender email/domain, and generate an API key under SMTP & API settings.
# In production this should be the CLIENT's own Brevo account, not the
# developer's — swapping it is just an env-var change.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Maidan Sports Complex
